# 依赖
node_modules/

# 开发模式产物（esbuild --dev 生成，含 sourcemap，不进仓库）
dev/

# 临时/中间产物
.tmp/
*.log
*.tgz
package/

# 视觉迭代截图（我自己看的，不进仓库）
shots/

# 审计脚本打包出来的临时包
tools/.audit.bundle.mjs

# 注意：dist/ 是**刻意提交**的 —— 单文件 HTML 就是这个项目的成品本身，
# 提交后仓库可以直接下载/用 GitHub Pages 打开，不必先装 node 再构建。
# 但发版用的两个资产不进仓库（它们走 GitHub Releases）：
dist/computer-anatomy-src-*.zip
dist/computer-anatomy-*.html
